{
  "version": 1,
  "preferred_language": "zh-CN",
  "protected_branches": [
    "main",
    "master",
    "production",
    "release/*"
  ],
  "integration_mode": "merge_allowed",
  "intent_confirmation": {
    "enabled": true,
    "required_before_write": "always",
    "clarification_after_confirmation": true,
    "force_stop_after_clarification_questions": true,
    "allow_direct_execute_preauthorization": false,
    "minimum_clarification_questions": 1,
    "default_clarification_questions": "2-5",
    "block_on_pending_confirmation": true,
    "block_on_pending_clarification": true
  },
  "critique": {
    "enabled": true,
    "threshold": "all_write_modes",
    "fallback_to_local_checklist": true,
    "require_user_choice_after_plan": true
  },
  "flow_management": {
    "enabled": true,
    "registry_file": ".autodev/current-flow.json",
    "flow_root": ".autodev/flows",
    "validate_before_write": true,
    "default_required_artifacts": [
      "brainstorm"
    ]
  },
  "stack_management": {
    "enabled": true,
    "registry_file": ".autodev/current-stack.json",
    "script_entry": "scripts/stackctl.sh",
    "auto_resume_enabled": true,
    "resume_threshold_hours": 24,
    "sync_flow_on_init": true
  },
  "scope_router": {
    "enabled": true,
    "minimum_safe_planning_level": "auto",
    "expand_active_frontier_only": true
  },
  "metaphor_layer": {
    "enabled": true,
    "default_mode": "off",
    "default_template": "restaurant",
    "available_templates": [
      "restaurant",
      "logistics",
      "factory"
    ],
    "allow_derived_templates": true,
    "reverse_parse_enabled": true
  },
  "checkpoint": {
    "milestone_on_write_start": true,
    "snapshot_gate": "always_before_write",
    "archive_after_each_verified_step": true,
    "fail_close_before_write": true
  },
  "blast_radius": {
    "enabled": true,
    "required_before_write": "always",
    "script_entry": "scripts/blast-radius.py",
    "default_reverse_depth": 2,
    "max_refs_per_section": 25,
    "include_neighbor_tests": true,
    "update_current_report": true,
    "fail_close_on_unknown_target": true,
    "fail_close_on_risk_escalation": true
  },
  "code_navigation": {
    "enabled": true,
    "preferred_provider": "codegraph",
    "provider_order": [
      "codegraph"
    ],
    "fallback": "rg-read",
    "required_before_raw_search": true,
    "record_downgrade_reason": true,
    "trust_non_stale_results": true
  },
  "drift_detection": {
    "enabled": true,
    "precheck_on_message": true,
    "precheck_events": [
      "message",
      "resume",
      "step_complete",
      "goal_change",
      "long_pause"
    ],
    "full_detect_requires_signal": true,
    "script_entry": "scripts/planctl.py",
    "staleness_hours": 24
  },
  "testing": {
    "default_backend_tests": true,
    "gui_autorun_on_gui_task": true,
    "gui_visible_execution": "preferred",
    "gui_block_completion_until_passed": true,
    "gui_case_matrix_required": true,
    "gui_evidence_required": true,
    "gui_autofix_retry_limit": 3,
    "big_test_current_test_required": true
  },
  "logging": {
    "usage_log_enabled": false,
    "receipt_verbosity": "full"
  }
}
